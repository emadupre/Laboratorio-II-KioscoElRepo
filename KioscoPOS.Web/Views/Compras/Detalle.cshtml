@using KioscoPOS.Web.Models.Enums
@model Compra
@{
    ViewData["Title"] = $"Compra #{Model.Id}";
    var borrador = Model.Estado == EstadoCompra.Borrador;
}

<h2>Compra #@Model.Id <span class="badge bg-secondary">@Model.Estado</span></h2>

@if (TempData["Ok"] != null) { <div class="alert alert-success">@TempData["Ok"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<dl class="row">
    <dt class="col-sm-2">Proveedor</dt><dd class="col-sm-10">@Model.Proveedor.Nombre</dd>
    <dt class="col-sm-2">Fecha</dt><dd class="col-sm-10">@Model.Fecha.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-2">Cargada por</dt><dd class="col-sm-10">@Model.Usuario.Email</dd>
    @if (Model.Estado == EstadoCompra.Anulada)
    {
        <dt class="col-sm-2">Anulada por</dt><dd class="col-sm-10">@Model.AnuladaPor?.Email</dd>
        <dt class="col-sm-2">Fecha anulación</dt><dd class="col-sm-10">@Model.FechaAnulacion?.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-2">Motivo</dt><dd class="col-sm-10">@Model.MotivoAnulacion</dd>
    }
</dl>

@if (borrador)
{
    <form asp-action="AgregarItem" asp-route-id="@Model.Id" method="post" class="row g-2 mb-3">
        <div class="col-md-5 position-relative">
            <input type="hidden" name="productoId" id="productoId" />
            <input type="text" id="productoBuscar" class="form-control" autocomplete="off"
                   placeholder="Producto (escribí para buscar)" required />
            <ul id="productoResultados" class="list-group position-absolute w-100" style="z-index:10"></ul>
        </div>
        <div class="col-md-2">
            <input name="cantidad" type="number" min="1" class="form-control" placeholder="Cantidad" required />
        </div>
        <div class="col-md-3">
            <input name="costoUnitario" id="costo" type="number" step="0.01" min="0.01" class="form-control"
                   placeholder="Costo unitario" required />
        </div>
        <div class="col-md-2"><button class="btn btn-primary w-100">Agregar</button></div>
    </form>
}

<table class="table align-middle">
    <thead>
        <tr><th>Producto</th><th>Cantidad</th><th>Costo unitario</th><th>Subtotal</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var d in Model.Detalles)
    {
        <tr>
            <td>@d.Producto.Nombre</td>
            <td>@d.Cantidad</td>
            <td>@d.CostoUnitario.ToString("C")</td>
            <td>@((d.Cantidad * d.CostoUnitario).ToString("C"))</td>
            <td class="text-end">
                @if (borrador)
                {
                    <form asp-action="QuitarItems" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <input type="hidden" name="detalleID" value="@d.Id" />
                        <button class="btn btn-sm btn-outline-danger">Quitar</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
    <tfoot>
        <tr><th colspan="3" class="text-end">Total</th><th>@Model.Total.ToString("C")</th><th></th></tr>
    </tfoot>
</table>

<div class="d-flex gap-2">
    @if (borrador)
    {
        <form asp-action="Confirmar" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('¿Confirmar la compra? Se actualiza el stock y el costo.');">
            <button class="btn btn-success">Confirmar compra</button>
        </form>
        <form asp-action="Eliminar" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('¿Eliminar el borrador?');">
            <button class="btn btn-outline-danger">Eliminar borrador</button>
        </form>
    }
    @if (Model.Estado == EstadoCompra.Confirmada)
    {
        <form asp-action="Anular" asp-route-id="@Model.Id" method="post" class="d-flex gap-2"
              onsubmit="return confirm('¿Anular la compra? Se revierte el stock.');">
            <input name="motivo" class="form-control" placeholder="Motivo de anulación" maxlength="250" required />
            <button class="btn btn-danger">Anular</button>
        </form>
    }
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>

@section Scripts {
    @if (borrador)
    {
        <script>
            const input = document.getElementById('productoBuscar');
            const lista = document.getElementById('productoResultados');
            const hidden = document.getElementById('productoId');
            const costo = document.getElementById('costo');
            let timer;

            input.addEventListener('input', () => {
                hidden.value = '';
                clearTimeout(timer);
                timer = setTimeout(async () => {
                    const resp = await fetch('/Compras/BuscarProducto?term=' + encodeURIComponent(input.value));
                    const items = await resp.json();
                    lista.innerHTML = '';
                    items.forEach(p => {
                        const li = document.createElement('li');
                        li.className = 'list-group-item list-group-item-action';
                        li.style.cursor = 'pointer';
                        li.textContent = p.nombre + ' (stock: ' + p.stock + ')';
                        li.onclick = () => {
                            input.value = p.nombre;
                            hidden.value = p.id;
                            costo.value = p.costo;   // sugiere el último costo
                            lista.innerHTML = '';
                        };
                        lista.appendChild(li);
                    });
                }, 300);
            });

            document.addEventListener('click', e => { if (e.target !== input) lista.innerHTML = ''; });

            // evita enviar sin haber elegido un producto de la lista
            input.form.addEventListener('submit', e => {
                if (!hidden.value) { e.preventDefault(); alert('Elegí un producto de la lista'); }
            });
        </script>
    }
}