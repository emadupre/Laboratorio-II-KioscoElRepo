@model KioscoPOS.Web.ViewModels.InicioVM

@{
    ViewData["Title"] = "Inicio";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Hola, @(User.Identity?.Name?.Split('@')[0])</h2>
            <p class="text-muted mb-0">El resumen de hoy es este:</p>
        </div>
        <div class="text-end">
            <div class="text-muted small">@DateTime.Now.ToString("dddd, d 'de' MMMM 'de' yyyy")</div>
        </div>
    </div>
    
    <div class="row g-3 mb-4">

        <div class="col-6 col-md-3">
            <div class="kp-stat-card">
                <div class="kp-stat-icon primary"><i class="bi bi-box-seam"></i></div>
                <div class="kp-stat-label">Productos</div>
                <div class="kp-stat-value">@Model.TotalProductos</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="kp-stat-card">
                <div class="kp-stat-icon @(Model.ProductosStockBajo > 0 ? "danger" : "success")">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div class="kp-stat-label">Stock bajo</div>
                <div class="kp-stat-value @(Model.ProductosStockBajo > 0 ? "text-danger" : "")">
                    @Model.ProductosStockBajo
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="kp-stat-card">
                <div class="kp-stat-icon success"><i class="bi bi-cart-check"></i></div>
                <div class="kp-stat-label">Ventas hoy</div>
                <div class="kp-stat-value">@Model.VentasHoy</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="kp-stat-card">
                <div class="kp-stat-icon warning"><i class="bi bi-currency-dollar"></i></div>
                <div class="kp-stat-label">Facturado hoy</div>
                <div class="kp-stat-value">$@Model.TotalVentasHoy.ToString("N0")</div>
            </div>
        </div>
    </div>

    <h5 class="mb-3 fw-bold">Accesos rápidos</h5>
    <div class="d-flex flex-wrap gap-2 mb-4">
        @if (!Model.TieneCajaAbierta)
        {
            <a asp-controller="Cajas" asp-action="Index" class="kp-quick-action primary"><i class="bi bi-unlock"></i> Abrir
                caja</a>
            }
        else
            {
                <a asp-controller="Ventas" asp-action="Nueva" class="kp-quick-action success">
                    <i class="bi bi-cart-plus"></i> Nueva Venta
                </a>
                <a asp-controller="Cajas" asp-action="Index" class="kp-quick-action">
                    <i class="bi bi-cash-stack"></i> Mi caja
                </a>
            }
            <a asp-controller="Productos" asp-action="Index" class="kp-quick-action">
                <i class="bi bi-box-seam"></i> Productos
            </a>
            @if (Model.EsAdmin)
            {
                <a asp-controller="Compras" asp-action="Create" class="kp-quick-action">
                    <i class="bi bi-box-arrow-in-down"></i> Nueva compra
                </a>
                <a asp-controller="Stock" asp-action="Historial" class="kp-quick-action">
                    <i class="bi bi-clock-history"></i> Historial de stock
                </a>
            }
        </div>

        @if (Model.ProductosStockBajo > 0)
        {
            <div class="alert alert-warning d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>
                    Tenés <strong>@Model.ProductosStockBajo</strong> producto(s) con stock bajo.
                    <a asp-controller="Productos" asp-action="Index" asp-route-estado="bajo" class="alert-link">Ver listado</a>
                </div>
            </div>
        }
    }
else
    {
        <div class="kp-auth-wrapper">
            <div class="text-center">
                <i class="bi bi-shop-window" style="font-size: 4rem;color:var(--kp-primary)"></i>
                <h1 class="mt-3">KioscoPOS</h1>
                <p class="lead text-muted">Sistema de punto de venta para kioscos 25hs.</p>
                <a asp-controller="Cuenta" asp-action="IniciarSesion" class="btn btn-primary btn-lg mt-2 px-4">
                    <i class="bi bi-box-arrow-in-right"></i> Iniciar sesion
                </a>
            </div>
        </div>
    }
