@model ProductoViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="row">
    <div class="col-md-8 mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="CodigoBarras" class="form-label"></label>
        <input asp-for="CodigoBarras" class="form-control" placeholder="Opcional">
        <span asp-validation-for="CodigoBarras" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3 position-relative">
        <label asp-for="CategoriaId" class="form-label"></label>
        <input type="hidden" asp-for="CategoriaId" id="CategoriaId" />
        <input type="text" id="categoriaBuscar" class="form-control" autocomplete="off"
               placeholder="Escribí para buscar..." value="@Model.CategoriaNombre" />
        <ul id="categoriaResultados" class="list-group position-absolute w-100" style="z-index:10"></ul>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3 position-relative">
        <label asp-for="MarcaId" class="form-label"></label>
        <input type="hidden" asp-for="MarcaId" id="MarcaId">
        <input type="text" id="marcaBuscar" class="form-control" autocomplete="off" placeholder="Escribí para buscar..."
               value="@Model.MarcaNombre">
        <ul id="marcaResultados" class="list-group position-absolute w-100" style="z-index:10"></ul>
        <span asp-validation-for="MarcaId" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-3 mb-3">
        <label asp-for="PrecioCosto" class="form-label"></label>
        <input asp-for="PrecioCosto" class="form-control" />
        <span asp-validation-for="PrecioCosto" class="text-danger"></span>
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="PrecioVenta" class="form-label"></label>
        <input asp-for="PrecioVenta" class="form-control" />
        <span asp-validation-for="PrecioVenta" class="text-danger"></span>
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="StockActual" class="form-label"></label>
        <input asp-for="StockActual" class="form-control" />
        <span asp-validation-for="StockActual" class="text-danger"></span>
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="StockMinimo" class="form-label"></label>
        <input asp-for="StockMinimo" class="form-control" />
        <span asp-validation-for="StockMinimo" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="ImagenArchivo" class="form-label"></label>
    @if (!string.IsNullOrEmpty(Model.ImagenPath))
    {
        <div class="mb-2"><img src="@Model.ImagenPath" style="max-height:100px" class="rounded" /></div>
    }
    <input asp-for="ImagenArchivo" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
    <span asp-validation-for="ImagenArchivo" class="text-danger"></span>
</div>

<button class="btn btn-primary">Guardar</button>
<a asp-action="Index" class="btn btn-secondary">Cancelar</a>

<script>
    function setupAutocomplete(inputId, listaId, hiddenId, endpoint, renderItem, onSelect) {
        const input = document.getElementById(inputId);
        const lista = document.getElementById(listaId);
        const hidden = document.getElementById(hiddenId);
        let timer;

        input.addEventListener('input', () => {
            hidden.value = 0;
            clearTimeout(timer);
            timer = setTimeout(async () => {
                const resp = await fetch(`${endpoint}?term=${encodeURIComponent(input.value)}`);
                const items = await resp.json();
                lista.innerHTML = '';
                items.forEach(item => {
                    const li = document.createElement('li');
                    li.className = 'list-group-item list-group-item-action';
                    li.style.cursor = 'pointer';
                    li.textContent = renderItem(item);
                    li.onclick = () => {
                        input.value = renderItem(item);
                        hidden.value = item.id;
                        if (onSelect) onSelect(item);
                        lista.innerHTML = '';
                    };
                    lista.appendChild(li);
                });
            }, 300);
        });

        document.addEventListener('click', e => {
            if (e.target !== input) lista.innerHTML = '';
        });
    }

    //uso:
    setupAutocomplete('categoriaBuscar', 'categoriaResultados', 'CategoriaId',
        '/Categorias/Buscar', c => c.nombre);

    setupAutocomplete('marcaBuscar', 'marcaResultados', 'MarcaId',
        '/Marcas/Buscar', m => m.nombre);
</script>