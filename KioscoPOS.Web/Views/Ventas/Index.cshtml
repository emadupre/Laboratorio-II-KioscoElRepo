@using KioscoPOS.Web.Models.Enums
@model PagedResult<Venta>
@{
    ViewData["Title"] = "Ventas";
    var estado = (EstadoVenta?)ViewBag.Estado;
}

<h2>Ventas</h2>

@if (TempData["Ok"] != null) { <div class="alert alert-success">@TempData["Ok"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="d-flex justify-content-between mb-3">
    <form method="get" asp-action="Index" class="d-flex gap-2">
        <select name="estado" class="form-select" onchange="this.form.submit()">
            <option value="">Todas</option>
            @foreach (var e in Enum.GetValues<EstadoVenta>())
            {
                <option value="@((int)e)" selected="@(estado == e ? "selected" : null)">@e</option>
            }
        </select>
    </form>
    <a asp-action="Nueva" class="btn btn-primary">Nueva venta</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>#</th><th>Fecha</th><th>Cajero</th><th>Medio de pago</th>
            <th class="text-end">Total</th><th>Estado</th><th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var v in Model.Items)
    {
        <tr>
            <td>@v.Id</td>
            <td>@v.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@v.Usuario.Email</td>
            <td>@v.MedioPago</td>
            <td class="text-end">$ @v.Total.ToString("N2")</td>
            <td>
                @if (v.Estado == EstadoVenta.Confirmada) { <span class="badge bg-success">Confirmada</span> }
                else { <span class="badge bg-danger">Anulada</span> }
            </td>
            <td><a asp-action="Detalle" asp-route-id="@v.Id">Ver</a></td>
        </tr>
    }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        @for (var i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.Page ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-estado="@((int?)estado)" asp-route-page="@i">@i</a>
            </li>
        }
    </ul>
</nav>
