@using KioscoPOS.Web.Models.Enums
@model KioscoPOS.Web.ViewModels.CajaPanelVM
@{ ViewData["Title"] = "Caja"; }

<h2>Caja</h2>

@if (TempData["Ok"] != null) { <div class="alert alert-success">@TempData["Ok"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

@if (Model.Caja == null)
{
    <div class="card" style="max-width:480px">
        <div class="card-body">
            <h5 class="card-title">No tenés una caja abierta</h5>
            <form asp-action="Abrir" method="post">
                <div class="mb-3">
                    <label class="form-label">Turno</label>
                    <select name="turno" class="form-select">
                        @foreach (var t in Enum.GetValues<Turno>())
                        {
                            <option value="@((int)t)">@t</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Fondo inicial</label>
                    <input name="fondoInicial" type="number" step="0.01" min="0" value="0"
                        class="form-control" required />
                </div>
                <button class="btn btn-primary">Abrir caja</button>
                <a asp-action="Historial" class="btn btn-outline-secondary">Ver historial</a>
            </form>
        </div>
    </div>
}
else
{
    var caja = Model.Caja;
    var r = Model.Resumen!;

    <p class="text-muted">
        Abierta el @caja.FechaApertura.ToString("dd/MM/yyyy HH:mm") · Turno @caja.Turno
    </p>
    <a asp-controller="MovimientosCaja" asp-action="Index" class="btn btn-outline-primary mb-3" >
        Ingresos y retiros
    </a>

    <table class="table" style="max-width:480px">
        <tr><td>Fondo inicial</td><td class="text-end">$ @r.FondoInicial.ToString("N2")</td></tr>
        <tr><td>Ventas en efectivo</td><td class="text-end">$ @r.VentasEfectivo.ToString("N2")</td></tr>
        <tr><td>Ingresos</td><td class="text-end text-success">+ $ @r.Ingresos.ToString("N2")</td></tr>
        <tr><td>Retiros</td><td class="text-end text-danger">- $ @r.Retiros.ToString("N2")</td></tr>
        <tr class="fw-bold"><td>Total esperado</td><td class="text-end">$ @r.TotalEsperado.ToString("N2")</td></tr>
    </table>

    <div class="card" style="max-width:480px">
        <div class="card-body">
            <h5 class="card-title">Cerrar caja</h5>
            <form asp-action="Cerrar" asp-route-id="@caja.Id" method="post"
                onsubmit="return confirm('¿Cerrar la caja? No se puede deshacer.');">
                <div class="mb-3">
                    <label class="form-label">Efectivo contado (arqueo)</label>
                    <input name="totalContado" type="number" step="0.01" min="0"
                        class="form-control" required />
                </div>
                <button class="btn btn-danger">Cerrar caja</button>
                <a asp-action="Historial" class="btn btn-outline-secondary">Ver historial</a>
            </form>
        </div>
    </div>
}
