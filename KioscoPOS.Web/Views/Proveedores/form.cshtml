@model Proveedor

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CUIT" class="form-label"></label>
    <input asp-for="CUIT" class="form-control" placeholder="20-12345678-9" />
    <span asp-validation-for="CUIT" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Contacto" class="form-label"></label>
    <input asp-for="Contacto" class="form-control" />
    <span asp-validation-for="Contacto" class="text-danger"></span>
</div>

<button class="btn btn-primary">Guardar</button>
<a asp-action="Index" class="btn btn-secondary">Cancelar</a>