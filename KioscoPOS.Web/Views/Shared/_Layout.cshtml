<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kiosco 24hs</title>
    
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KioscoPOS.Web.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm kp-navbar mb-4">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Inicio" asp-action="Index"><i
                    class="bi bi-shop-window"></i> KioscoPOS</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Inicio" asp-action="Index"><i
                                    class="bi bi-house-door"></i> Inicio</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Ventas" asp-action="Index"><i class="bi bi-cart3"></i>
                                        Ventas</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Cajas" asp-action="Index"><i
                                            class="bi bi-cash-stack"></i> Caja</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" asp-area="" asp-controller="Productos" asp-action="index"><i
                                                class="bi bi-box-seam"></i> Productos</a>
                                            </li>
                                            <li class="nav-item dropdown">
                                                <a href="#" class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown">
                                                    <i class="bi bi-grid"></i> Catálogos
                                                </a>
                                                <ul class="dropdown-menu">
                                                    <li class="dropdown-item">
                                                        <a class="nav-link" asp-area="" asp-controller="Categorias" asp-action="index">
                                                            <i class="bi bi-tag"></i> Categorias</a>
                                                        </li>
                                                        <li class="dropdown-item">
                                                            <a class="nav-link" asp-controller="Marcas" asp-action="Gestion"><i
                                                                class="bi bi-bookmark"></i> Marcas (Vue)</a>
                                                            </li>
                                                            <li class="dropdown-item">
                                                                <a class="nav-link text-dark" asp-area="" asp-controller="Proveedores"
                                                                   asp-action="index">
                                                                    <bi class="bi-truck"></bi> Proveedores
                                                                </a>
                                                            </li>
                                                            <li class="dropdown-item">
                                                                <a class="nav-link" asp-area="" asp-controller="Categorias" asp-action="Gestion">
                                                                    <bi class="bi-code-slash"></bi> Categorias
                                                                    (Vue)
                                                                </a>
                                                            </li>
                                                        </ul>
                                                    </li>
                                                    <li class="nav-item">
                                                        <a class="nav-link" asp-controller="Stock" asp-action="Historial"><i
                                                            class="bi bi-bar-chart"></i> Stock</a>
                                                        </li>
                                                        @if (User.IsInRole("Administrador"))
                                                        {
                                                            <li class="nav-item">
                                                                <a class="nav-link" asp-controller="Compras" asp-action="Index"><i
                                                                    class="bi bi-box-arrow-in-down"></i> Compras</a>
                                                                </li>
                                                            }
                                                        </ul>
                                                        <ul class="navbar-nav">
                                                            @if (User.Identity?.IsAuthenticated == true)
                                                            {
                                                                <li class="nav-item dropdown">
                                                                    <a href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"
                                                                       class="nav-link dropdown-toggle d-flex align-items-center gap-2">
                                                                        <span class="rounded-circle d-inline-flex align-items-center justify-content-center"
                                                                              style="width:32px;height:32px;background:var(--kp-primary);color:white;font-weight:700;font-size:.85rem">@(User.Identity.Name?.FirstOrDefault().ToString().ToUpper()
                                                                              ?? "?")</span>
                                                                            <span>@(User.Identity.Name ?? "Usuario")</span>
                                                                        </a>
                                                                        <ul class="dropdown-menu dropdown-menu-end">
                                                                            <li><a asp-controller="Cuenta" asp-action="Perfil" class="dropdown-item"><i
                                                                                class="bi bi-person-circle"></i> Mi perfil</a>
                                                                            </li>
                                                                            <li>
                                                                                <hr class="dropdown-divider">
                                                                            </li>
                                                                            <li>
                                                                                <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post"
                                                                                      class="d-inline">
                                                                                    <button type="submit" class="dropdown-item text-danger"><i
                                                                                        class="bi bi-box-arrow-right"></i> Cerrar Sesion</button>
                                                                                    </form>
                                                                                </li>
                                                                            </ul>
                                                                        </li>
                                                                    }
                                                            else
                                                                    {
                                                                        <li class="nav-item">
                                                                            <a class="nav-link text-dark" asp-controller="Cuenta" asp-action="IniciarSesion"><i
                                                                                class="bi bi-box-arrow-in-right"></i> Iniciar
                                                                                sesión</a>
                                                                            </li>
                                                                        }
                                                                    </ul>
                                                                </div>
                                                            </div>
                                                        </nav>
                                                    </header>
                                                    <main class="container mt-4">@RenderBody()</main>
                                                    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
                                                    @await RenderSectionAsync("Scripts", required: false)
                                                </body>

                                            </html>