<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kiosco 24hs</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KioscoPOS.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Inicio" asp-action="Index">Kiosco 24hs</a>

                <div class="ms-auto">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-light me-3">
                            Hola, @User.Identity.Name
                            @if (User.IsInRole("Administrador"))
                            {
                                <span class="badge bg-warning text-dark ms-1">Admin</span>
                            }
                        </span>
                        <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm">Salir</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Cuenta" asp-action="IniciarSesion"
                           class="btn btn-outline-light btn-sm">Entrar</a>
                    }
                </div>
            </div>
        </nav>
        <main class="container mt-4">@RenderBody()</main>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>